#!/usr/bin/env node
// Starts the pi-studio daemon. Its own file so `pi-studio` can sit in PATH without the repository
// being on it, and so the app is one word to run from any folder.
//
// `--version`, `doctor`, `update` and `uninstall` are handled here, before the server is imported, so
// they work in a source clone and in a staged/installed copy alike. Everything else starts the app.
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { buildIdentity, formatVersion, parseFlags, registerManagedRuntime, selfInstallFlags } from "./runtime.mjs";

const here = dirname(fileURLToPath(import.meta.url));
const appRoot = join(here, "..");
const [command, ...rest] = process.argv.slice(2);
const { flags, rest: positional } = parseFlags(rest);

if (command === "--version" || command === "-V" || command === "version") {
	const identity = buildIdentity(appRoot);
	if (flags.json) {
		const { engines, ...serialisable } = identity;
		console.log(JSON.stringify(serialisable, null, 2));
	} else {
		console.log(formatVersion(identity));
	}
} else if (command === "doctor") {
	// A report rather than a start, so it must answer on a machine where the app cannot start yet:
	// it imports the doctor alone, never the server.
	const { runDoctor } = await import("../server/doctor.ts");
	process.exitCode = runDoctor(flags);
} else if (command === "add") {
	// Install a plugin from a repository into the plugins folder. It is offered in settings right
	// away — the page scans on open — so no daemon restart is needed, and enabling stays a click there.
	const { addPlugin } = await import("./plugin-add.mjs");
	const url = positional[0];
	if (!url) {
		console.error("usage: pi-studio add <git-url>");
		process.exit(2);
	}
	try {
		const { name, updated } = await addPlugin(url, { flags, stream: true });
		console.log(updated ? `${name} updated — its registration is untouched` : `installed ${name} — enable it in settings, plugins`);
	} catch (error) {
		console.error(error.message);
		process.exit(1);
	}
} else if (command === "plugins") {
	// Restart every registered plugin in the running daemon, from the registration on disk: no
	// daemon restart and nothing written. The token and the port come from the daemon's own
	// state folder, so this is one command to the daemon that already ran against it.
	const { reloadPlugins } = await import("./plugins-reload.mjs");
	if (positional[0] !== "reload") {
		console.error("usage: pi-studio plugins reload");
		process.exit(2);
	}
	try {
		const { roster, problems } = await reloadPlugins();
		for (const one of roster) console.log(`${one.name} — ${one.running ? "running" : one.dormant ? "starts on open" : "not running"}`);
		for (const one of problems) console.log(`${one.name ? `${one.name}: ` : ""}${one.problem}`);
		if (!roster.length && !problems.length) console.log("no plugins registered — reloaded to an empty roster");
	} catch (error) {
		console.error(error.message);
		process.exit(1);
	}
} else if (command === "service") {
	// Install, report and remove the per-user systemd unit. Needs Linux only;
	// the daemon itself keeps its loopback default either way.
	const { installService, removeService, serviceStatus } = await import("./service.mjs");
	const installFlags = { ...selfInstallFlags(appRoot), ...flags };
	try {
		if (positional[0] === "install") await installService({ appRoot, flags: installFlags });
		else if (positional[0] === "remove" || positional[0] === "uninstall") await removeService({ flags: installFlags });
		else if (!positional[0] || positional[0] === "status") await serviceStatus({ flags: installFlags });
		else {
			console.error("usage: pi-studio service install (default port 4801, all interfaces)");
			console.error("       pi-studio service status");
			console.error("       pi-studio service remove");
			console.error("       pi-studio service install --port <n>  to choose another fixed port");
			console.error("       pi-studio service install --host 127.0.0.1  to keep it on this machine only");
			process.exit(2);
		}
	} catch (error) {
		console.error(error.message);
		process.exit(1);
	}
} else if (command === "password") {
	// Set, change or remove the master password the signed-out unlock page asks for. The token
	// link stays as break-glass either way; nothing here starts or stops the daemon.
	const { removePassword, setPassword } = await import("./auth.mjs");
	const passwordFlags = { ...selfInstallFlags(appRoot), ...flags };
	try {
		if (positional[0] === "remove") removePassword({ flags: passwordFlags });
		else if (!positional[0] || positional[0] === "set") await setPassword({ flags: passwordFlags });
		else {
			console.error("usage: pi-studio password          set or change the master password");
			console.error("       pi-studio password remove   remove it");
			process.exit(2);
		}
	} catch (error) {
		console.error(error.message);
		process.exit(1);
	}
} else if (command === "update" || command === "uninstall") {
	const { update, uninstall } = await import("./manage.mjs");
	// An installed copy knows its own install root and bin folder, so a later update or uninstall
	// need not be handed the flags the install used. Explicit flags still win.
	const installFlags = { ...selfInstallFlags(appRoot), ...flags };
	try {
		if (command === "update") await update(installFlags);
		else uninstall(installFlags);
	} catch (error) {
		console.error(error.message);
		process.exit(1);
	}
} else {
	// Record this managed copy as running (a no-op for a source clone or a dist tree, which must
	// never claim or clear an installation's marker), then start.
	registerManagedRuntime(appRoot);
	process.argv[1] = join(appRoot, "server.ts");
	await import("../server.ts");
}
